# Anthropic API
# Get a key from https://console.anthropic.com/ — must start with sk-ant-
ANTHROPIC_API_KEY=sk-ant-replace-me

# LumenX admin API
LUMENX_BASE_URL=https://lumenx-demo.up.railway.app
LUMENX_ADMIN_TOKEN=lmx_replace_me

# Confidence Net
# Drafts scoring >= threshold are auto-sent; below routes to human review.
# Conservative start at 0.95; lower as the MLP precision improves.
CONFIDENCE_THRESHOLD=0.90

# Inbox poller cadence (seconds)
POLL_INTERVAL_SEC=10

# Model selection — cheap model for routing, premium for drafting
INTENT_MODEL=claude-haiku-4-5-20251001
DRAFT_MODEL=claude-sonnet-4-6

# Local SQLite DB. For production swap to a Postgres DSN.
# Note: only sqlite:/// is currently supported by db/connection.py;
# moving to Postgres requires swapping in SQLAlchemy.
DATABASE_URL=sqlite:///data/agent.db

# Wiki location, relative to project root
WIKI_DIR=wiki/products

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
